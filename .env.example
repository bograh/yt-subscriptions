# Google OAuth client (type "Web application") — see README
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_URL=http://localhost:8080/auth/callback

# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, Ollama, LM Studio, vLLM...)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Send response_format=json_object (only if your provider supports it)
# AI_JSON_MODE=1

# Optional: require a password (HTTP basic auth, any username). Strongly recommended
# if the dashboard is reachable from other machines.
# DASHBOARD_PASSWORD=

# YouTube API units per day for your Google Cloud project
# YOUTUBE_DAILY_QUOTA=10000

# PORT=8080
# DATA_DIR=data
