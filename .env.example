# Every setting the dashboard reads. Copy to .env (make setup does) and fill in.
# Defaults and parsing live in internal/config/config.go.

# Where you open the dashboard. The OAuth redirect is PUBLIC_URL/auth/callback;
# add exactly that URI to your Google OAuth client.
# PUBLIC_URL=https://subs.example.com

# Google OAuth client (type "Web application") — see README
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_URL=   # only if it must differ from PUBLIC_URL/auth/callback

# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, Ollama, LM Studio, vLLM...)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Send response_format=json_object (only if your provider supports it)
# AI_JSON_MODE=1

# Password for the dashboard (HTTP basic auth, any username). Required whenever
# the app listens on a non-loopback address, which includes Docker.
DASHBOARD_PASSWORD=
# ALLOW_NO_PASSWORD=1   # only if access is restricted another way (e.g. port bound to 127.0.0.1)

# YouTube API units per day for your Google Cloud project
# YOUTUBE_DAILY_QUOTA=10000

# PORT=8080
# DATA_DIR=data
