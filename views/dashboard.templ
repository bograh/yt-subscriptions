package views

import (
	"fmt"
	"yt-subscriptions/internal/store"
)

templ layout() {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Subscription Cleanup</title>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.1.11"></script>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<style>
				.htmx-request .htmx-indicator { display: inline-block; }
				.htmx-indicator { display: none; }
			</style>
		</head>
		<body class="min-h-screen bg-zinc-950 text-zinc-200 antialiased">
			{ children... }
		</body>
	</html>
}

templ Dashboard(p Page) {
	@layout() {
		<main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
			<header class="flex flex-wrap items-center justify-between gap-4">
				<div>
					<h1 class="text-2xl font-semibold tracking-tight text-white">Subscription Cleanup</h1>
					<p class="text-sm text-zinc-400">
						if p.State.SyncedAt.IsZero() {
							Not synced yet
						} else {
							Last synced { Ago(p.State.SyncedAt) }
						}
					</p>
				</div>
				<div class="flex flex-wrap gap-2">
					if !p.Connected {
						<a href="/auth/login" class="rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-500">Connect YouTube</a>
					} else {
						<button hx-post="/sync" hx-target="#job" hx-swap="outerHTML" class="rounded-lg bg-zinc-800 px-4 py-2 text-sm font-medium hover:bg-zinc-700">Sync subscriptions</button>
						<button hx-post="/analyze" hx-target="#job" hx-swap="outerHTML" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 disabled:opacity-50" disabled?={ !p.AIConfigured || len(p.State.Channels) == 0 }>Analyze new</button>
						<button hx-post="/analyze?all=1" hx-target="#job" hx-swap="outerHTML" hx-confirm="Re-run the AI on every channel?" class="rounded-lg bg-zinc-800 px-4 py-2 text-sm font-medium hover:bg-zinc-700 disabled:opacity-50" disabled?={ !p.AIConfigured || len(p.State.Channels) == 0 }>Re-analyze all</button>
					}
				</div>
			</header>
			if !p.OAuthReady {
				@notice("Set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET in .env to connect your YouTube account. See README.md.")
			}
			if !p.AIConfigured {
				@notice("Set AI_BASE_URL and AI_MODEL (and AI_API_KEY if needed) in .env to enable analysis.")
			}
			if p.Error != "" {
				<div class="mt-4 rounded-lg border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200">{ p.Error }</div>
			}
			@JobBanner(p.Job)
			@StatsBar(p.Stats, false)
			@settings(p)
			<form
				id="filters"
				hx-get="/channels"
				hx-target="#channel-list"
				hx-swap="outerHTML"
				hx-push-url="true"
				hx-trigger="change, input from:#q delay:300ms"
				class="mt-8 flex flex-wrap items-center gap-3"
			>
				<div class="inline-flex rounded-lg bg-zinc-900 p-1 ring-1 ring-zinc-800">
					@groupOption("category", "Category", p.List.GroupBy)
					@groupOption("type", "Kind of videos", p.List.GroupBy)
					@groupOption("verdict", "Suggestion", p.List.GroupBy)
				</div>
				<select name="verdict" class="rounded-lg bg-zinc-900 px-3 py-2 text-sm ring-1 ring-zinc-800">
					@verdictOption("", "All suggestions", p.List.Verdict)
					@verdictOption("unsubscribe", "Unsubscribe", p.List.Verdict)
					@verdictOption("review", "Review", p.List.Verdict)
					@verdictOption("keep", "Keep", p.List.Verdict)
					@verdictOption("unanalyzed", "Not analyzed", p.List.Verdict)
				</select>
				<input id="q" type="search" name="q" value={ p.List.Query } placeholder="Search channels…" class="min-w-56 flex-1 rounded-lg bg-zinc-900 px-3 py-2 text-sm ring-1 ring-zinc-800 placeholder:text-zinc-500"/>
			</form>
			@ChannelList(p.List)
		</main>
	}
}

templ notice(msg string) {
	<div class="mt-4 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-200">{ msg }</div>
}

templ groupOption(value, label, current string) {
	<label class="cursor-pointer">
		<input type="radio" name="group" value={ value } class="peer sr-only" checked?={ value == current }/>
		<span class="block rounded-md px-3 py-1.5 text-sm text-zinc-400 peer-checked:bg-zinc-700 peer-checked:text-white">{ label }</span>
	</label>
}

templ verdictOption(value, label, current string) {
	<option value={ value } selected?={ value == current }>{ label }</option>
}

templ settings(p Page) {
	<details class="mt-6 rounded-xl bg-zinc-900/60 ring-1 ring-zinc-800">
		<summary class="cursor-pointer px-4 py-3 text-sm font-medium text-zinc-300">Personalize the suggestions</summary>
		<div class="grid gap-6 border-t border-zinc-800 p-4 md:grid-cols-2">
			<form hx-post="/interests" hx-swap="none" class="space-y-2">
				<label for="interests" class="block text-sm font-medium">What are you into these days?</label>
				<textarea id="interests" name="interests" rows="4" placeholder="e.g. Go & backend engineering, system design, football highlights, cooking. Not interested in gaming or celebrity drama anymore." class="w-full rounded-lg bg-zinc-950 p-3 text-sm ring-1 ring-zinc-800 placeholder:text-zinc-600">{ p.State.Interests }</textarea>
				<button class="rounded-lg bg-zinc-800 px-3 py-1.5 text-sm hover:bg-zinc-700">
					Save <span class="htmx-indicator">…</span>
				</button>
				<p class="text-xs text-zinc-500">Used by the AI on the next analysis. Run "Re-analyze all" after changing it.</p>
			</form>
			<form hx-post="/history" hx-encoding="multipart/form-data" hx-target="#history-result" class="space-y-2">
				<label class="block text-sm font-medium">Watch history (optional, recommended)</label>
				<p class="text-xs text-zinc-500">
					Export from
					<a href="https://takeout.google.com/" target="_blank" class="text-indigo-400 underline">Google Takeout</a>
					→ YouTube → history, format <b>JSON</b>. Upload <code>watch-history.json</code> so suggestions know which channels you actually watch.
				</p>
				<input type="file" name="file" accept=".json,application/json" class="block w-full text-sm file:mr-3 file:rounded-md file:border-0 file:bg-zinc-800 file:px-3 file:py-1.5 file:text-zinc-200"/>
				<button class="rounded-lg bg-zinc-800 px-3 py-1.5 text-sm hover:bg-zinc-700">Import <span class="htmx-indicator">…</span></button>
				<div id="history-result" class="text-sm text-zinc-400">
					if p.State.HistoryImported {
						Watch history imported.
					}
				</div>
			</form>
		</div>
	</details>
}

templ JobBanner(j Job) {
	if j.Running {
		<div id="job" hx-get="/job" hx-trigger="every 1s" hx-swap="outerHTML" class="mt-6 rounded-xl bg-zinc-900 p-4 ring-1 ring-zinc-800">
			<div class="flex justify-between text-sm">
				<span>{ j.Label }</span>
				if j.Total > 0 {
					<span class="text-zinc-400">{ fmt.Sprint(j.Done) } / { fmt.Sprint(j.Total) }</span>
				}
			</div>
			<div class="mt-2 h-2 overflow-hidden rounded-full bg-zinc-800">
				<div class="h-full bg-indigo-500 transition-all" style={ fmt.Sprintf("width: %d%%", j.Percent()) }></div>
			</div>
		</div>
	} else {
		<div id="job"></div>
	}
}

templ StatsBar(s Stats, oob bool) {
	<section id="stats" hx-swap-oob?={ oob } class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
		@stat("Subscriptions", s.Total, "text-white")
		@stat("Keep", s.Keep, "text-emerald-300")
		@stat("Review", s.Review, "text-amber-300")
		@stat("Unsubscribe", s.Unsubscribe, "text-rose-300")
		@stat("Inactive > 1 year", s.Inactive, "text-zinc-300")
		if s.HistoryImported {
			@stat("Never watched", s.NeverWatched, "text-zinc-300")
		} else {
			@stat("Not analyzed", s.Unanalyzed, "text-zinc-300")
		}
	</section>
}

templ stat(label string, n int, color string) {
	<div class="rounded-xl bg-zinc-900 p-4 ring-1 ring-zinc-800">
		<div class={ "text-2xl font-semibold tabular-nums", color }>{ fmt.Sprint(n) }</div>
		<div class="mt-1 text-xs text-zinc-400">{ label }</div>
	</div>
}

templ ChannelList(l List) {
	<div id="channel-list" class="mt-6 space-y-10">
		if l.Shown == 0 {
			<p class="py-16 text-center text-zinc-500">No channels to show. Connect your account and sync, or change the filters.</p>
		}
		for _, g := range l.Groups {
			<section>
				<h2 class="mb-3 flex items-baseline gap-2 text-lg font-semibold text-white">
					{ g.Name }
					<span class="text-sm font-normal text-zinc-500">{ fmt.Sprint(len(g.Channels)) }</span>
				</h2>
				<div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
					for _, c := range g.Channels {
						@ChannelCard(c)
					}
				</div>
			</section>
		}
	</div>
}

templ ChannelCard(c store.Channel) {
	<article id={ "ch-" + c.ID } class="flex flex-col gap-3 rounded-xl bg-zinc-900 p-4 ring-1 ring-zinc-800">
		<div class="flex items-start gap-3">
			<img src={ c.Thumbnail } alt="" loading="lazy" class="size-11 shrink-0 rounded-full bg-zinc-800"/>
			<div class="min-w-0 flex-1">
				<a href={ templ.SafeURL(c.URL()) } target="_blank" class="block truncate font-medium text-white hover:underline">{ c.Title }</a>
				<p class="text-xs text-zinc-400">
					{ Compact(c.SubscriberCount) } subs · last upload { Ago(c.LastUpload) }
					if c.Inactive() {
						<span class="text-rose-300">· inactive</span>
					}
				</p>
				if c.WatchCount > 0 {
					<p class="text-xs text-zinc-500">Watched { fmt.Sprint(c.WatchCount) }× · last { Ago(c.LastWatched) }</p>
				}
			</div>
			if c.Analysis != nil {
				<span class={ "shrink-0 rounded-full px-2 py-0.5 text-xs font-medium ring-1", VerdictClass(c.Analysis.Verdict) }>{ VerdictLabel(c.Analysis.Verdict) }</span>
			}
		</div>
		if c.Analysis != nil {
			<div class="flex flex-wrap gap-1.5 text-xs">
				<span class="rounded bg-zinc-800 px-2 py-0.5 text-zinc-300">{ c.Analysis.Category }</span>
				<span class="rounded bg-zinc-800 px-2 py-0.5 text-zinc-300">{ c.Analysis.ContentType }</span>
			</div>
			<p class="text-sm text-zinc-400">{ c.Analysis.Reason }</p>
		}
		<div class="mt-auto flex justify-end">
			<button
				hx-delete={ "/channels/" + c.ID }
				hx-target={ "#ch-" + c.ID }
				hx-swap="outerHTML"
				hx-confirm={ "Unsubscribe from " + c.Title + "?" }
				class="rounded-md px-2.5 py-1 text-xs text-zinc-400 ring-1 ring-zinc-700 hover:bg-rose-600 hover:text-white hover:ring-rose-600"
			>
				Unsubscribe <span class="htmx-indicator">…</span>
			</button>
		</div>
	</article>
}
